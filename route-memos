#!/usr/bin/env python3

"""Copy synced Apple Voice Memos into the matching course memo directory."""

from __future__ import annotations

import argparse
import calendar
from dataclasses import dataclass
from datetime import date, datetime, time, timedelta
import json
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import tempfile


SEMESTER_DIR = Path(__file__).resolve().parent
VOICE_MEMOS_DIR = (
    Path.home()
    / "Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings"
)
SEMESTER_START = date(2026, 8, 24)
SEMESTER_END = date(2026, 12, 18)
CLASS_DAYS = {calendar.TUESDAY, calendar.THURSDAY}
MINIMUM_OVERLAP = timedelta(minutes=5)
LAUNCH_AGENT_LABEL = "com.daniel.school.memo-router"
LAUNCH_AGENT_PATH = Path.home() / f"Library/LaunchAgents/{LAUNCH_AGENT_LABEL}.plist"
LOG_PATH = Path.home() / "Library/Logs/lecture-memo-router.log"


@dataclass(frozen=True)
class ClassMeeting:
    course: str
    starts: time
    ends: time


@dataclass(frozen=True)
class Recording:
    path: Path
    uuid: str
    started: datetime
    duration: timedelta


CLASS_MEETINGS = (
    ClassMeeting("MATH351", time(11, 30), time(12, 45)),
    ClassMeeting("MATH451", time(14, 30), time(15, 45)),
)


def ffprobe_path() -> str:
    executable = shutil.which("ffprobe")
    if executable is None:
        raise RuntimeError("ffprobe is missing; install it with: brew install ffmpeg")
    return executable


def inspect_recording(path: Path) -> Recording | None:
    # icloud file mtimes reflect sync time, not recording time
    result = subprocess.run(
        [
            ffprobe_path(),
            "-v",
            "error",
            "-show_entries",
            "format=duration:format_tags=creation_time,voice-memo-uuid",
            "-of",
            "json",
            str(path),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None

    try:
        details = json.loads(result.stdout)["format"]
        tags = details["tags"]
        recording_uuid = tags["voice-memo-uuid"]
        started = datetime.fromisoformat(tags["creation_time"].replace("Z", "+00:00"))
        duration = timedelta(seconds=float(details["duration"]))
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        return None

    return Recording(
        path=path,
        uuid=recording_uuid,
        started=started.astimezone(),
        duration=duration,
    )


def matching_class(recording: Recording) -> ClassMeeting | None:
    recording_date = recording.started.date()
    if not SEMESTER_START <= recording_date <= SEMESTER_END:
        return None
    if recording.started.weekday() not in CLASS_DAYS:
        return None

    recording_end = recording.started + recording.duration
    candidates: list[tuple[timedelta, ClassMeeting]] = []
    for meeting in CLASS_MEETINGS:
        class_start = datetime.combine(
            recording_date, meeting.starts, tzinfo=recording.started.tzinfo
        )
        class_end = datetime.combine(
            recording_date, meeting.ends, tzinfo=recording.started.tzinfo
        )
        overlap = max(
            timedelta(0), min(recording_end, class_end) - max(recording.started, class_start)
        )
        if overlap >= MINIMUM_OVERLAP:
            candidates.append((overlap, meeting))

    if not candidates:
        return None
    return max(candidates, key=lambda candidate: candidate[0])[1]


def existing_uuids() -> set[str]:
    # exports can change container bytes, so dedupe with apple's memo uuid
    uuids: set[str] = set()
    for meeting in CLASS_MEETINGS:
        memo_dir = SEMESTER_DIR / meeting.course / "memos"
        if not memo_dir.is_dir():
            continue
        for path in memo_dir.glob("*.m4a"):
            recording = inspect_recording(path)
            if recording:
                uuids.add(recording.uuid)
    return uuids


def next_destination(course: str, recording_date: date) -> Path:
    memo_dir = SEMESTER_DIR / course / "memos"
    memo_dir.mkdir(parents=True, exist_ok=True)
    prefix = recording_date.isoformat()
    used_parts: list[int] = []
    for path in memo_dir.glob(f"{prefix}-pt[0-9][0-9].m4a"):
        try:
            used_parts.append(int(path.stem.rsplit("-pt", 1)[1]))
        except (IndexError, ValueError):
            continue
    part = max(used_parts, default=0) + 1
    return memo_dir / f"{prefix}-pt{part:02d}.m4a"


def copy_atomically(source: Path, destination: Path) -> None:
    with tempfile.NamedTemporaryFile(
        dir=destination.parent, prefix=f".{destination.stem}.", suffix=".m4a", delete=False
    ) as temporary:
        temporary_path = Path(temporary.name)
    try:
        shutil.copy2(source, temporary_path)
        temporary_path.replace(destination)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def route_recordings(source: Path, dry_run: bool, quiet: bool) -> int:
    if not source.is_dir():
        raise RuntimeError(f"Voice Memos directory not found: {source}")

    known_uuids = existing_uuids()
    copied = 0
    for path in sorted(source.glob("*.m4a")):
        recording = inspect_recording(path)
        if recording is None or recording.uuid in known_uuids:
            continue
        meeting = matching_class(recording)
        if meeting is None:
            continue

        destination = next_destination(meeting.course, recording.started.date())
        action = "Would copy" if dry_run else "Copied"
        print(f"{action} {path.name} -> {destination.relative_to(SEMESTER_DIR)}")
        if not dry_run:
            copy_atomically(path, destination)
            known_uuids.add(recording.uuid)
        copied += 1

    if copied == 0 and not quiet:
        print("No new class recordings found.")
    return copied


def launch_agent_config() -> dict[str, object]:
    # WatchPaths runs on changes; RunAtLoad catches anything missed
    return {
        "Label": LAUNCH_AGENT_LABEL,
        "ProgramArguments": [str(Path(__file__).resolve()), "--quiet"],
        "EnvironmentVariables": {
            "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
        },
        "WatchPaths": [str(VOICE_MEMOS_DIR)],
        "RunAtLoad": True,
        "ProcessType": "Background",
        "StandardOutPath": str(LOG_PATH),
        "StandardErrorPath": str(LOG_PATH),
    }


def install_launch_agent() -> None:
    LAUNCH_AGENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    was_installed = LAUNCH_AGENT_PATH.exists()
    if was_installed:
        subprocess.run(
            ["launchctl", "bootout", f"gui/{os.getuid()}", str(LAUNCH_AGENT_PATH)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    with LAUNCH_AGENT_PATH.open("wb") as plist:
        plistlib.dump(launch_agent_config(), plist, sort_keys=False)
    subprocess.run(
        ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(LAUNCH_AGENT_PATH)],
        check=True,
    )
    subprocess.run(
        ["launchctl", "kickstart", f"gui/{os.getuid()}/{LAUNCH_AGENT_LABEL}"],
        check=True,
    )
    print(f"Installed and started {LAUNCH_AGENT_LABEL}")
    print(f"Watching: {VOICE_MEMOS_DIR}")
    print(f"Log: {LOG_PATH}")


def uninstall_launch_agent() -> None:
    subprocess.run(
        ["launchctl", "bootout", f"gui/{os.getuid()}", str(LAUNCH_AGENT_PATH)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if LAUNCH_AGENT_PATH.exists():
        LAUNCH_AGENT_PATH.unlink()
    print(f"Uninstalled {LAUNCH_AGENT_LABEL}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Route synced Voice Memos to course folders by recording time."
    )
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--install", action="store_true", help="install the launchd watcher")
    actions.add_argument("--uninstall", action="store_true", help="remove the launchd watcher")
    parser.add_argument("--dry-run", action="store_true", help="show copies without writing")
    parser.add_argument("--quiet", action="store_true", help="hide the no-new-recordings message")
    parser.add_argument(
        "--source", type=Path, default=VOICE_MEMOS_DIR, help=argparse.SUPPRESS
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.install:
            install_launch_agent()
        elif args.uninstall:
            uninstall_launch_agent()
        else:
            route_recordings(args.source, args.dry_run, args.quiet)
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"route-memos: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
